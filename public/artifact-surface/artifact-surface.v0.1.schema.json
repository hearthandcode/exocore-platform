{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.github.io/exocore/schemas/artifact-surface.v0.1.schema.json",
  "title": "Exocore Artifact Surface Projection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "artifacts"],
  "properties": {
    "contract": { "$ref": "#/$defs/contract" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactReference" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "version",
        "authorityEffect",
        "canonical",
        "syntheticOnly",
        "readOnly",
        "mountState",
        "sourceIdentity",
        "sourceSetDigest",
        "deniedEffects",
        "limits"
      ],
      "properties": {
        "projectionId": { "const": "exocore-artifact-surface-v0.1" },
        "version": { "const": "0.1.0" },
        "authorityEffect": { "const": "derived-non-authoritative" },
        "canonical": { "const": false },
        "syntheticOnly": { "const": true },
        "readOnly": { "const": true },
        "mountState": { "const": "unmounted-candidate" },
        "sourceIdentity": { "type": "string", "minLength": 1 },
        "sourceSetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "deniedEffects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "canonical-write",
              "filesystem-scan",
              "ingestion",
              "workflow-transition",
              "human-gate-decision",
              "persistence",
              "provider-call",
              "network-access",
              "credential-access",
              "scheduling",
              "publication",
              "migration",
              "deployment",
              "git-mutation"
            ]
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "title",
        "summary",
        "artifactClass",
        "lifecycleState",
        "reviewState",
        "sensitivity",
        "artifactPath",
        "contentDigest",
        "provenance",
        "contentPreview",
        "relations"
      ],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^AR-PUBLIC-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 320 },
        "artifactClass": {
          "enum": ["source", "evidence", "inference", "hypothesis", "proposal", "plan", "projection", "receipt", "historical-material"]
        },
        "lifecycleState": {
          "enum": ["draft", "active", "reviewed", "amended", "needs-review", "archived", "deprecated", "superseded"]
        },
        "reviewState": {
          "enum": ["unreviewed", "in-review", "reviewed-current", "re-review-required", "deferred", "not-required", "approved-for-design"]
        },
        "sensitivity": { "enum": ["public", "internal", "restricted"] },
        "artifactPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "contentPreview": { "$ref": "#/$defs/contentPreview" },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLabel", "sourceKind", "summary"],
      "properties": {
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceKind": { "enum": ["synthetic-fixture"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    },
    "contentPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "text", "truncated"],
      "properties": {
        "mediaType": { "const": "text/markdown" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "truncated": { "type": "boolean" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetArtifactId"],
      "properties": {
        "kind": { "enum": ["supports", "supersedes", "derived-from", "implements", "relates-to", "conflicts-with"] },
        "targetArtifactId": { "type": "string", "pattern": "^AR-PUBLIC-[0-9]{3}$" }
      }
    }
  }
}
