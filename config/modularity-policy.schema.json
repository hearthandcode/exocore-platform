{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.org/schemas/exocore/modularity-policy.v1.schema.json",
  "title": "Exocore modularity policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "version", "preferredMaxLines", "boundaryMaxLines", "sourceExtensions", "excludedDirectories", "boundaryFiles", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "policy": { "const": "exocore.modularity-policy.v1" },
    "version": { "const": 1 },
    "preferredMaxLines": { "type": "integer", "minimum": 1 },
    "boundaryMaxLines": { "type": "integer", "minimum": 1 },
    "sourceExtensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\." } },
    "excludedDirectories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "boundaryFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "reason", "splitPlan", "reviewBy"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "splitPlan": { "type": "string", "minLength": 1 },
          "reviewBy": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
