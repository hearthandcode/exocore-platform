{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hearthandcode/exocore-platform/blob/main/contracts/agent-runtime/exocore.agent-runtime.run.v1.schema.json",
  "title": "Exocore Agent Runtime Run Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "session",
    "agent",
    "model",
    "context",
    "tools",
    "policy",
    "output"
  ],
  "properties": {
    "schema": {
      "const": "exocore.agent-runtime.run.v1"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "root_run_id",
        "parent_run_id",
        "correlation_id",
        "idempotency_key"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/stableId"
        },
        "root_run_id": {
          "$ref": "#/$defs/stableId"
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "correlation_id": {
          "$ref": "#/$defs/stableId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_spec_ref",
        "archetype_ref",
        "objective",
        "orchestration"
      ],
      "properties": {
        "agent_spec_ref": {
          "$ref": "#/$defs/namespacedId"
        },
        "archetype_ref": {
          "$ref": "#/$defs/namespacedId"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "orchestration": {
          "$ref": "#/$defs/orchestration"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "required_capabilities",
        "provider_constraints"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/stableId"
        },
        "model": {
          "$ref": "#/$defs/stableId"
        },
        "required_capabilities": {
          "$ref": "#/$defs/stableIdSet"
        },
        "provider_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "credentials",
            "retained_state",
            "fallback"
          ],
          "properties": {
            "network": {
              "type": "boolean"
            },
            "credentials": {
              "type": "boolean"
            },
            "retained_state": {
              "type": "boolean"
            },
            "fallback": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "token_budget",
        "disclosure",
        "conflict_policy",
        "omission_receipt"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/contextSource"
          }
        },
        "token_budget": {
          "type": "integer",
          "minimum": 256,
          "maximum": 131072
        },
        "disclosure": {
          "enum": [
            "public-safe",
            "internal",
            "restricted"
          ]
        },
        "conflict_policy": {
          "enum": [
            "fail-closed",
            "higher-authority",
            "human-gate"
          ]
        },
        "omission_receipt": {
          "const": true
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "block",
        "effects",
        "parallelism"
      ],
      "properties": {
        "allow": {
          "$ref": "#/$defs/stableIdSet"
        },
        "block": {
          "$ref": "#/$defs/stableIdSet"
        },
        "effects": {
          "$ref": "#/$defs/stableIdSet"
        },
        "parallelism": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_turns",
        "max_child_depth",
        "max_concurrent_children",
        "hook_budget",
        "retry_limit",
        "timeout_ms",
        "human_gates",
        "hooks"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_turns": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "max_child_depth": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "max_concurrent_children": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16
          ]
        },
        "hook_budget": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ]
        },
        "retry_limit": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            4,
            8
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "human_gates": {
          "$ref": "#/$defs/stableIdSet"
        },
        "hooks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/hook"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "strict",
        "repair_attempts",
        "receipt_route"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/namespacedId"
        },
        "strict": {
          "type": "boolean"
        },
        "repair_attempts": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            4
          ]
        },
        "receipt_route": {
          "$ref": "#/$defs/namespacedId"
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^exocore\\.[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableIdSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "contextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision",
        "digest",
        "authority_class",
        "sensitivity",
        "disclosure",
        "layer",
        "precedence",
        "cache_band",
        "freshness",
        "required",
        "content_mode",
        "token_budget",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_type": {
          "enum": [
            "operational-charter",
            "agents-guide",
            "archetype",
            "hub-intelligence",
            "skill-methodology",
            "task-workflow",
            "memory-retrieval",
            "runtime-injection"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ],
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_class": {
          "enum": [
            "source",
            "evidence",
            "inference",
            "hypothesis",
            "proposal",
            "plan",
            "projection",
            "receipt",
            "historical"
          ]
        },
        "sensitivity": {
          "enum": [
            "public-safe",
            "internal",
            "restricted"
          ]
        },
        "disclosure": {
          "enum": [
            "include",
            "summarize",
            "reference-only",
            "deny"
          ]
        },
        "layer": {
          "enum": [
            "kernel-policy",
            "operator-identity",
            "hub-operational-governance",
            "program-archetype",
            "repository-project",
            "directory-local",
            "task-workflow",
            "turn-runtime-injection"
          ]
        },
        "precedence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "cache_band": {
          "enum": [
            "stable",
            "session",
            "turn",
            "ephemeral"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "content_mode": {
          "enum": [
            "inline",
            "reference",
            "summary",
            "retrieval"
          ]
        },
        "token_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_id",
        "owner",
        "scope",
        "point",
        "priority",
        "dependencies",
        "input_contract",
        "output_contract",
        "allowed_outcomes",
        "effect",
        "authority_requirement",
        "timeout_ms",
        "call_budget",
        "idempotency",
        "replay",
        "failure_mode"
      ],
      "properties": {
        "hook_id": {
          "$ref": "#/$defs/stableId"
        },
        "owner": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "enum": [
            "session",
            "run",
            "turn",
            "context-discovery",
            "context-assembly",
            "model-selection",
            "provider-request",
            "response-stream",
            "message",
            "tool-call",
            "tool-execution",
            "child-agent",
            "aggregation",
            "memory",
            "checkpoint",
            "settlement"
          ]
        },
        "point": {
          "enum": [
            "before",
            "after",
            "error",
            "finally"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dependencies": {
          "$ref": "#/$defs/stableIdSet"
        },
        "input_contract": {
          "$ref": "#/$defs/namespacedId"
        },
        "output_contract": {
          "$ref": "#/$defs/namespacedId"
        },
        "allowed_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "continue",
              "append",
              "patch",
              "block",
              "retry",
              "redirect",
              "suspend",
              "terminate"
            ]
          }
        },
        "effect": {
          "enum": [
            "none",
            "local-read",
            "local-write",
            "external-read",
            "external-write",
            "send",
            "spend",
            "publish",
            "deploy"
          ]
        },
        "authority_requirement": {
          "$ref": "#/$defs/stableId"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "call_budget": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "idempotency": {
          "enum": [
            "required",
            "optional",
            "not-applicable"
          ]
        },
        "replay": {
          "enum": [
            "deterministic",
            "observe-only",
            "never"
          ]
        },
        "failure_mode": {
          "enum": [
            "fail-closed",
            "fail-open-observability"
          ]
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "nodes",
        "edges"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "sequential",
            "parallel",
            "map",
            "reduce",
            "supervisor",
            "debate",
            "handoff",
            "quorum"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "agent_spec_ref",
        "input_contract",
        "output_contract",
        "capabilities",
        "tools",
        "disclosure",
        "effects",
        "budget",
        "depends_on"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/stableId"
        },
        "node_type": {
          "enum": [
            "agent-run",
            "deterministic-transform",
            "policy-gate",
            "human-gate",
            "tool-operation",
            "aggregation",
            "checkpoint",
            "terminal-receipt"
          ]
        },
        "agent_spec_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^exocore\\.[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
        },
        "input_contract": {
          "$ref": "#/$defs/namespacedId"
        },
        "output_contract": {
          "$ref": "#/$defs/namespacedId"
        },
        "capabilities": {
          "$ref": "#/$defs/stableIdSet"
        },
        "tools": {
          "$ref": "#/$defs/stableIdSet"
        },
        "disclosure": {
          "enum": [
            "public-safe",
            "internal",
            "restricted"
          ]
        },
        "effects": {
          "$ref": "#/$defs/stableIdSet"
        },
        "budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "depends_on": {
          "$ref": "#/$defs/stableIdSet"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/stableId"
        },
        "to": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "dependency",
            "structured-data",
            "supervision",
            "cancellation",
            "evidence",
            "handoff",
            "compensation",
            "aggregation"
          ]
        }
      }
    }
  },
  "x-source-projection": {
    "source_id": "hub-exocore-agent-runtime-v1",
    "source_revision": 1,
    "source_package_digest": "7666dd8a71589f9fc404f89619675c541b3c59a2c1753eada2ed3912c6ebe59b",
    "authority": "non-authoritative-projection"
  }
}
