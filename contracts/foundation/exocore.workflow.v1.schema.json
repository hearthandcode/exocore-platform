{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/contracts/exocore.workflow.v1.schema.json",
  "title": "Exocore typed workflow contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workflow_id",
    "workflow_version",
    "owner",
    "input_contract",
    "output_contract",
    "idempotency_key",
    "states",
    "transitions",
    "steps",
    "failure_state"
  ],
  "properties": {
    "schema": { "const": "exocore.workflow.v1" },
    "workflow_id": { "$ref": "#/$defs/namespacedId" },
    "workflow_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "input_contract": { "$ref": "#/$defs/namespacedId" },
    "output_contract": { "$ref": "#/$defs/namespacedId" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "event", "human_gate"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "event": { "$ref": "#/$defs/namespacedId" },
          "human_gate": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "operation", "authority_owner", "on_error"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "operation": { "$ref": "#/$defs/namespacedId" },
          "authority_owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "on_error": { "enum": ["fail", "rollback", "retry"] }
        }
      }
    },
    "failure_state": { "type": "string" }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^exocore\\.[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
    }
  }
}
