{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/contracts/exocore.module-mount.v1.schema.json",
  "title": "Exocore module mount contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "module_id",
    "module_version",
    "register",
    "config_schema",
    "flag_declaration",
    "routes",
    "commands",
    "contracts",
    "config_keys",
    "health"
  ],
  "properties": {
    "schema": { "const": "exocore.module-mount.v1" },
    "module_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "module_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "register": { "const": "register" },
    "config_schema": { "$ref": "#/$defs/namespacedId" },
    "flag_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag_id",
        "default",
        "owner",
        "enabled_behavior",
        "disabled_behavior"
      ],
      "properties": {
        "flag_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_-]*$"
        },
        "default": { "const": false },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "enabled_behavior": { "type": "string", "minLength": 1 },
        "disabled_behavior": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedId" }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedId" }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedId" }
    },
    "config_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "health": { "const": "health" }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^exocore\\.[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
    }
  }
}
