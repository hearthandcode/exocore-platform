{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/contracts/exocore.identifier-policy.v1.schema.json",
  "title": "Exocore identifier and primitive vocabulary policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "patterns",
    "primitive_vocabulary",
    "namespace_owners",
    "unknown_identifier_effect"
  ],
  "properties": {
    "schema": { "const": "exocore.identifier-policy.v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "stable_id",
        "namespaced_id",
        "config_key",
        "diagnostic_code"
      ],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "stable_id": { "type": "string", "minLength": 1 },
        "namespaced_id": { "type": "string", "minLength": 1 },
        "config_key": { "type": "string", "minLength": 1 },
        "diagnostic_code": { "type": "string", "minLength": 1 }
      }
    },
    "primitive_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identifier",
          "value",
          "record",
          "command",
          "query",
          "event",
          "port",
          "adapter",
          "policy",
          "transition",
          "projection",
          "workflow",
          "receipt"
        ]
      }
    },
    "namespace_owners": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^exocore\\.[a-z][a-z0-9.-]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}$"
      }
    },
    "unknown_identifier_effect": { "const": "fail-closed" }
  }
}
