{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.github.io/exocore-platform/contracts/profile-evaluation/v1/fixture.schema.json",
  "title": "Exocore profile-evaluation fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "profile", "prompt", "expected", "policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "instructions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 }
      }
    },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_output", "required_terms"],
      "properties": {
        "exact_output": { "type": "string", "minLength": 1 },
        "required_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "credentials", "max_attempts"],
      "properties": {
        "network": { "const": "deny" },
        "credentials": { "const": "deny" },
        "max_attempts": { "const": 1 }
      }
    }
  }
}
