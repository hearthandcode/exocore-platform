{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.example/contracts/exocore.persistence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "authority_model",
    "migration_contract",
    "entities"
  ],
  "properties": {
    "schema": { "const": "exocore.persistence.v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "authority_model": {
      "const": {
        "sqlite": "local-transitory",
        "postgresql": "durable-authority",
        "qdrant": "vector-projection",
        "neo4j": "graph-projection"
      }
    },
    "migration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "payload", "sequence", "projection", "cutover"],
      "properties": {
        "identity": { "type": "string", "minLength": 10 },
        "payload": { "type": "string", "minLength": 10 },
        "sequence": { "type": "string", "minLength": 10 },
        "projection": { "type": "string", "minLength": 10 },
        "cutover": { "type": "string", "minLength": 10 }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "primary_key", "columns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "primary_key": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "columns": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                { "enum": ["integer", "text", "timestamp", "json"] },
                { "type": "boolean" }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    }
  }
}
