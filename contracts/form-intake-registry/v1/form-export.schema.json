{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.org/schemas/exocore/form-export.v1.schema.json",
  "title": "exocore.form-export.v1 validating contract for the current form-v3 export",
  "type": "object",
  "required": ["schema", "version", "exportedAt", "totalQuestions", "totalAnswered", "sections", "rawResponses"],
  "properties": {
    "schema": { "const": "exocore-architecture-form-v3" },
    "version": { "type": "number" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "totalQuestions": { "type": "integer", "minimum": 0 },
    "totalAnswered": { "type": "integer", "minimum": 0 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "total", "answered", "responses"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "total": { "type": "integer", "minimum": 0 },
          "answered": { "type": "integer", "minimum": 0 },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["questionId", "questionLabel", "questionType", "required", "answered"],
              "properties": {
                "questionId": { "type": "string", "minLength": 1 },
                "questionLabel": { "type": "string" },
                "questionType": { "enum": ["text", "textarea", "single-choice", "multi-choice", "ranking", "build-a-list", "scale", "select"] },
                "required": { "type": "boolean" },
                "value": {},
                "answered": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "rawResponses": { "type": "object" },
    "meta": {
      "type": "object",
      "properties": { "requiredFields": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "Unknown optional fields are preserved but inert. meta.requiredFields is the fail-closed extension declaration; unknown names are rejected by the application validator. The current form app does not emit meta."
}
