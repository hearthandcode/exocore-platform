{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthandcode.org/schemas/exocore/intake-registry.v1.schema.json",
  "title": "exocore.intake-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "schema_version", "source_kind", "source_locator", "source_digest", "ingested_at", "last_seen_at", "export_schema_version", "dedupe_key", "lineage_key", "payload", "payload_digest", "payload_locator", "sensitivity", "review_state", "disposition_state", "verification_state", "superseded_by", "recovery_path"],
  "properties": {
    "registry_id": { "type": "string", "pattern": "^ir-[0-9a-f]{26}$" },
    "schema_version": { "const": "exocore.intake-registry.v1" },
    "source_kind": { "enum": ["form-export", "hub-intake-candidate"] },
    "source_locator": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": "string", "format": "date-time" },
    "export_schema_version": { "type": "string", "minLength": 1 },
    "dedupe_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lineage_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": { "type": ["object", "null"] },
    "payload_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_locator": { "type": ["string", "null"] },
    "sensitivity": { "enum": ["public-safe", "internal", "restricted"] },
    "review_state": { "enum": ["unreviewed", "in-review", "reviewed", "deferred"] },
    "disposition_state": { "enum": ["candidate", "accepted-proposal", "parked", "rejected"] },
    "verification_state": { "const": false },
    "superseded_by": { "type": ["string", "null"] },
    "recovery_path": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    { "properties": { "payload": { "type": "object" }, "payload_digest": { "type": "null" }, "payload_locator": { "type": "null" } } },
    { "properties": { "payload": { "type": "null" }, "payload_digest": { "type": "string" }, "payload_locator": { "type": "string" } } }
  ]
}
